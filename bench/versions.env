# Pins for the benchmark nodes (bench/cloud/setup-client.sh). Crates are pinned by bench/Cargo.lock,
# Go modules by adapters/go/go.sum, Java by adapters/java/pom.xml. PostgreSQL comes from the PGDG
# apt repository (18.x, the version the run records in machine-db.txt).
RUST_VERSION=1.97.1
GO_VERSION=go1.27.4
ASYNCPG_VERSION=0.32.0
PSYCOPG_VERSION=3.3.9
PSYCOPG_POOL_VERSION=3.3.3
UVLOOP_VERSION=0.23.0
